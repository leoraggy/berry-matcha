PORT=3000
NODE_ENV=development

CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-host>/
SESSION_SECRET=<random-secret-at-least-32-characters>

STRIPE_PRIVATE_KEY=sk_test_<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>

CLIENT_URL=http://localhost:5173
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
ADMIN_EMAILS=<authorized-admin-email>

GOOGLE_APPLICATION_CREDENTIALS=./<google-service-account-file>.json
GOOGLE_CLOUD_STORAGE_BUCKET=<google-cloud-storage-bucket>
